%%% spsnotation.sty -- notation for the SPS noninterference-checker lecture.
%%%
%%% Written for this project only. Keep every macro that appears in a claim
%%% BODY short: the usable ledger row is about 102pt, roughly 25-28 characters
%%% of rendered math at 7pt, and a discharged body is wrapped in \sout, which
%%% cannot line-break inside math.

\ProvidesPackage{spsnotation}

%% ---------------------------------------------------------------- predicates
%% All set in \mathrm so they read as named predicates rather than products of
%% single-letter variables.
\newcommand{\Sec}{\mathrm{Sec}}                 % the security property
\newcommand{\Obs}{\mathrm{Obs}}                 % observation projection
\newcommand{\Trace}{\mathrm{Tr}}                % trace
\newcommand{\Adm}{\mathrm{Adm}}                 % admitted state set
\newcommand{\PairDom}{\mathrm{PairDom}}         % coupled low-equal pair domain
\newcommand{\Bad}{\mathrm{Bad}}                 % bad-state predicate
\newcommand{\ProdSafe}{\mathrm{ProdSafe}}       % product safety
\newcommand{\NFConf}{\mathrm{NFConf}}           % normal-form conformance
\newcommand{\Bind}{\mathrm{Bind}}               % artifact identity binding
\newcommand{\Total}{\mathrm{Total}}             % manifest totality
\newcommand{\DiagOK}{\mathrm{DiagOK}}           % diagnostic health gate
\newcommand{\PairedRef}{\mathrm{PairRef}}       % paired backend refinement
\newcommand{\ReplayCov}{\mathrm{Replay}}        % replay coverage of a witness
\newcommand{\LowEq}{\mathrm{LowEq}}             % low-equivalence
\newcommand{\Proj}{\mathrm{Proj}}               % coalition projection
\newcommand{\Rel}{R}                            % the authorized-release function

%% ------------------------------------------------------------------- objects
\newcommand{\coalitions}{\mathcal{A}}           % the derived coalition family
\newcommand{\manifest}{\mathcal{M}}             % the policy manifest
\newcommand{\artifact}{T}                       % the frozen artifact
\newcommand{\pipeline}{I}                       % the pipeline digest
\newcommand{\entry}{e}                          % an entry point
\newcommand{\coal}{A}                           % a coalition
\newcommand{\dnclose}{{\downarrow}}             % downward closure

%% ------------------------------------------------------------- four outcomes
%% Rendered as small caps so they are visibly a closed enumeration rather than
%% ordinary words in running prose.
\newcommand{\Verified}{\textsc{verified}}
\newcommand{\Unsafe}{\textsc{unsafe}}
\newcommand{\Unknown}{\textsc{unknown}}
\newcommand{\Conditional}{\textsc{conditional}}
\newcommand{\Proved}{\textsc{proved}}
\newcommand{\Ctrex}{\textsc{counterexample}}
\newcommand{\RelReq}{\textsc{relational required}}

%% --------------------------------------------------------------------- misc
%% \code inside math needs \text{\code{...}}; see the skill's authoring notes.
\newcommand{\code}[1]{\texttt{#1}}
%% Evidence levels L0..L4, so they are typeset consistently everywhere.
\newcommand{\Lv}[1]{\textsf{L#1}}
%% A fixture name, for the many references to files in the harness.
\newcommand{\fx}[1]{\texttt{\small #1}}

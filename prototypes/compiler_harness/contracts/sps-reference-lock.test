# The executable-reference bridge is a byte-for-byte, nonclaimable SPS mirror.
# It carries no generated interface distribution of its own; that much larger
# package remains under the independent sps-interface lock.

# RUN: env -u SPS_REFERENCE_ROOT %python %harness/tools/sync_sps_reference.py --check | %FileCheck %s --check-prefix=VENDOR
# VENDOR: SPS executable reference source comparison: SKIPPED (SPS_REFERENCE_ROOT unset)
# VENDOR: verified SPS executable reference vendor: boundary=ExecutableReferenceOnly tree={{[0-9a-f]+}} cases=21 tests=20 families=10/61

# The upstream interface builder is authoritative vendored source, not a
# harness consumer with a copied normative table.
# RUN: %python %harness/tools/sps_interfaces.py --check-consumers | %FileCheck %s --check-prefix=CONSUMERS
# CONSUMERS: verified SPS interface consumers: no copied normative tables

# The lock records the intended coverage counts and the reference JSON never
# serializes a harness-computed ModelStatus.
# RUN: %python -c "import json,pathlib; root=pathlib.Path(r'%harness'); lock=json.loads((root/'contracts/sps-reference.lock.json').read_text()); assert lock['formatId']=='SPS-Harness-Reference-Lock-v1'; assert lock['claimBoundary']=='ExecutableReferenceOnly'; assert lock['counts']=={'fixtureCases':21,'unitTests':20,'executableFamilies':10,'profileFamilies':61}; values=[json.loads(p.read_text()) for p in (root/'contracts/vendor/sps-reference-rev4/reference').rglob('*.json')]; walk=lambda v: any(k=='modelStatus' or walk(x) for k,x in v.items()) if isinstance(v,dict) else any(walk(x) for x in v) if isinstance(v,list) else False; assert not any(walk(v) for v in values); print('reference lock boundary and nonclaimable JSON verified')" | %FileCheck %s --check-prefix=BOUNDARY
# BOUNDARY: reference lock boundary and nonclaimable JSON verified


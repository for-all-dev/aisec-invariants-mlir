# CROSS-FILE IDENTIFIER BINDING FOR THE CANDIDATE BUNDLES (WFInputs section 3).
#
# The nine bundles under artifacts/<case>/ carry {policy,abi,contracts,
# release-table,expected-report}.json bound by sha256 into artifact.json.
# c/check_harness.py validates each sidecar in isolation. It does NOT check
# that an identifier written in one sidecar resolves in another, so a policy
# could bind a release id that no release table declares, name an audience
# principal that no policy declares, or replace the one fixed observation
# model, and every existing artifacts/ test would still pass.
#
# tools/check_wfinputs.py implements the resolvable-reference fragment of
# WFInputs(M,ABI,R,K,TE,FPT,I,T) that is expressible against these mirrors:
#   item 3   dom(M.releaseBindings) = dom(R), and every audience, footprint,
#            carrier, component, root, placement and bound reference resolves
#   items 3/4 release footprints resolve to declared policy components
#   items 3/7 every release carrier has one declared mechanism contract
#   items 1/2/10 every visibility basis is total in the declared principals
#   item 11  the timing environment completely types the timing model
#   section 7 the single fixed observation model Theta_ct
#   section 2.5.1 the REQUIRED explicit empty TimingEnvironmentContract
#
# WHAT A GREEN RUN HERE DOES NOT MEAN. This is tier PreflightV1. It does not
# establish WFInputs (items 4, 5, 9, 10, 12 and 14 quantify over the frozen
# reparsed module and a satisfiability obligation that do not exist here), does
# not establish NFConforms, and computes no ModelStatus, DeploymentStatus,
# PolicyReviewStatus, receipt, or witness. The local toolchain is LLVM 17.0.6;
# the normative boundary is 22.1.8 and is absent. Silence proves nothing.
#
# The negative arms follow artifacts/interfaces-negative.test: copy the tree
# into a per-arm isolated root (%t.a .. %t.e), mutate exactly one field, REPAIR
# the artifact.json sidecar digest so the envelope binding is not what fails,
# and assert the specific diagnostic. Each arm gets its own root so one
# mutation cannot mask or be masked by another.

# --- positive arm: the real tree binds ---------------------------------------
# RUN: %python %harness/tools/check_wfinputs.py 2>&1 | %FileCheck %s --check-prefix=CLEAN
# CLEAN: wfinputs binding checks passed: 9 candidate bundles
# CLEAN: checked: cross-file identifier resolution
# CLEAN: not checked: WFInputs items 4, 5, 9, 10, 12, 14

# Non-vacuity for the timing migration: the explicit empty contract is present
# in ALL NINE bundles, not merely somewhere. Pinned as a count, because
# presence is the easy half.
# RUN: grep -l '"latencyClassId": "lat.fixed.1"' %harness/artifacts/*/contracts.json | wc -l | tr -d ' ' | %FileCheck %s --check-prefix=TIMINGCOUNT
# TIMINGCOUNT: {{^9$}}
# And every one of them is the EMPTY contract: an empty choice domain,
# occurrence map, latency table and coupling map (spec section 2.5.1). Four
# empty fields across nine bundles is exactly 36 lines; a bundle that dropped
# or populated any one of them moves the count.
# RUN: grep -hE '"(choiceDomain|latencyMeaning)": \[\]|"(occurrences|pairedChoiceCoupling)": \{\}' %harness/artifacts/*/contracts.json | wc -l | tr -d ' ' | %FileCheck %s --check-prefix=EMPTYTE
# EMPTYTE: {{^36$}}

# --- shared tree setup for the negative arms ---------------------------------
# RUN: rm -rf %t.a %t.b %t.c %t.d %t.e

# --- (a) policy binds a release id that dom(R) does not contain --------------
# WFInputs item 3 requires dom(M.releaseBindings) = dom(R). Per
# SPS_Lecture_Notes/part5-soundness.tex:296-298 a manifest whose release
# bindings no longer match dom(R) is Unknown(ManifestMismatch); the tool NAMES
# that reason class as reporting text and still emits no ModelStatus.
# RUN: mkdir -p %t.a/tools
# RUN: cp %harness/tools/check_wfinputs.py %t.a/tools/check_wfinputs.py
# RUN: cp -R %harness/artifacts %t.a/artifacts
# RUN: %python -c "import hashlib,json,pathlib; root=pathlib.Path(r'%t.a/artifacts/audience-mismatch'); side=root/'policy.json'; value=json.loads(side.read_text()); value['release_bindings']=['totally_bogus_release_id_not_in_table']; side.write_text(json.dumps(value,indent=2)+'\n'); identity_path=root/'artifact.json'; identity=json.loads(identity_path.read_text()); identity['candidate_sidecar_sha256']['policy.json']=hashlib.sha256(side.read_bytes()).hexdigest(); identity_path.write_text(json.dumps(identity,indent=2)+'\n')"
# RUN: not %python %t.a/tools/check_wfinputs.py 2>&1 | %FileCheck %s --check-prefix=BINDDOM
# Both inclusions are reported: the dangling binding and the now-unbound entry.
# BINDDOM: artifacts/audience-mismatch/policy.json: release_bindings[0]: release id 'totally_bogus_release_id_not_in_table' does not resolve to any release-table entries id; dom(M.releaseBindings) is not equal to dom(R) (WFInputs item 3) (would-be disposition reason class: ManifestMismatch)
# BINDDOM: artifacts/audience-mismatch/release-table.json: entries[0].id: release id 'masked_class_v1' is not bound by policy release_bindings; dom(M.releaseBindings) is not equal to dom(R) (WFInputs item 3) (would-be disposition reason class: ManifestMismatch)
# The reason class is quoted as reporting text, never issued as a result.
# BINDDOM: no ModelStatus, DeploymentStatus, PolicyReviewStatus, receipt, or witness is computed
# Pinned as a cardinality: exactly the two domain-equality violations name a
# reason class, and nothing else in the run does.
# RUN: not %python %t.a/tools/check_wfinputs.py 2>&1 | grep -c "would-be disposition reason class: " | %FileCheck %s --check-prefix=BINDDOMCOUNT
# BINDDOMCOUNT: {{^2$}}

# --- (b) a release audience names an undeclared principal --------------------
# audience-mismatch is the bundle that exists to teach the audience relation.
# 'mallory' is in no policy.principals, hence in no coalition derived from the
# basis, so no audience relation can be computed for the entry (item 2 forbids
# authored overrides; item 3 requires the reference to resolve).
# RUN: mkdir -p %t.b/tools
# RUN: cp %harness/tools/check_wfinputs.py %t.b/tools/check_wfinputs.py
# RUN: cp -R %harness/artifacts %t.b/artifacts
# RUN: %python -c "import hashlib,json,pathlib; root=pathlib.Path(r'%t.b/artifacts/audience-mismatch'); side=root/'release-table.json'; value=json.loads(side.read_text()); value['entries'][0]['audience']=['mallory']; side.write_text(json.dumps(value,indent=2)+'\n'); identity_path=root/'artifact.json'; identity=json.loads(identity_path.read_text()); identity['candidate_sidecar_sha256']['release-table.json']=hashlib.sha256(side.read_bytes()).hexdigest(); identity_path.write_text(json.dumps(identity,indent=2)+'\n')"
# RUN: not %python %t.b/tools/check_wfinputs.py 2>&1 | %FileCheck %s --check-prefix=AUDIENCE
# AUDIENCE: artifacts/audience-mismatch/release-table.json: entries[0].audience[0]: principal 'mallory' is not declared in policy principals, so it belongs to no coalition derived from the policy basis (WFInputs items 2, 3 and 8)
# AUDIENCE: wfinputs binding checks failed

# --- (c) a release footprint names an undeclared component -------------------
# WFInputs items 3 and 4: the footprint is the declared component extent of the
# release; an unresolvable component means the terminal output schedule cannot
# be shown to cover it exactly once.
# RUN: mkdir -p %t.c/tools
# RUN: cp %harness/tools/check_wfinputs.py %t.c/tools/check_wfinputs.py
# RUN: cp -R %harness/artifacts %t.c/artifacts
# RUN: %python -c "import hashlib,json,pathlib; root=pathlib.Path(r'%t.c/artifacts/audience-mismatch'); side=root/'release-table.json'; value=json.loads(side.read_text()); value['entries'][0]['footprint']=['ghost_component']; side.write_text(json.dumps(value,indent=2)+'\n'); identity_path=root/'artifact.json'; identity=json.loads(identity_path.read_text()); identity['candidate_sidecar_sha256']['release-table.json']=hashlib.sha256(side.read_bytes()).hexdigest(); identity_path.write_text(json.dumps(identity,indent=2)+'\n')"
# RUN: not %python %t.c/tools/check_wfinputs.py 2>&1 | %FileCheck %s --check-prefix=FOOTPRINT
# FOOTPRINT: artifacts/audience-mismatch/release-table.json: entries[0].footprint[0]: component 'ghost_component' is not declared in policy components (WFInputs items 3 and 4)
# FOOTPRINT: wfinputs binding checks failed

# --- (d) the fixed observation model is replaced -----------------------------
# Spec section 7 fixes exactly one observation model for Rev-4 and states that
# removing or coarsening an event kind or field is not configuration. There is
# no second legal value for this field, so a swapped name is not a variant
# profile, it is an unmodelled one. No reason class is quoted here, because the
# corpus does not state which PublicReasonClassesV1 member applies.
# RUN: mkdir -p %t.d/tools
# RUN: cp %harness/tools/check_wfinputs.py %t.d/tools/check_wfinputs.py
# RUN: cp -R %harness/artifacts %t.d/artifacts
# RUN: %python -c "import hashlib,json,pathlib; root=pathlib.Path(r'%t.d/artifacts/abi-alias-disjoint'); side=root/'policy.json'; value=json.loads(side.read_text()); value['fixed_observation_model']='Theta_something_else_entirely'; side.write_text(json.dumps(value,indent=2)+'\n'); identity_path=root/'artifact.json'; identity=json.loads(identity_path.read_text()); identity['candidate_sidecar_sha256']['policy.json']=hashlib.sha256(side.read_bytes()).hexdigest(); identity_path.write_text(json.dumps(identity,indent=2)+'\n')"
# RUN: not %python %t.d/tools/check_wfinputs.py 2>&1 | %FileCheck %s --check-prefix=THETA
# THETA: artifacts/abi-alias-disjoint/policy.json: fixed_observation_model: 'Theta_something_else_entirely' is not the single Rev-4 observation model 'Theta_ct'; coarsening or replacing an event kind is not configuration (spec section 7 and WFInputs item 1)
# THETA: wfinputs binding checks failed

# --- (e) the explicit empty TimingEnvironmentContract is deleted -------------
# Spec section 2.5.1 makes the explicit empty contract REQUIRED when no ideal
# timing choice is modelled. Deleting it leaves "timing_contracts": [] behind,
# which is exactly the pre-migration state of these bundles: the ABSENCE of the
# required object rather than an instance of it. The tool must not accept the
# absence as an empty model.
# RUN: mkdir -p %t.e/tools
# RUN: cp %harness/tools/check_wfinputs.py %t.e/tools/check_wfinputs.py
# RUN: cp -R %harness/artifacts %t.e/artifacts
# RUN: %python -c "import hashlib,json,pathlib; root=pathlib.Path(r'%t.e/artifacts/launder-scan'); side=root/'contracts.json'; value=json.loads(side.read_text()); del value['timing_environment']; side.write_text(json.dumps(value,indent=2)+'\n'); identity_path=root/'artifact.json'; identity=json.loads(identity_path.read_text()); identity['candidate_sidecar_sha256']['contracts.json']=hashlib.sha256(side.read_bytes()).hexdigest(); identity_path.write_text(json.dumps(identity,indent=2)+'\n')"
# RUN: not %python %t.e/tools/check_wfinputs.py 2>&1 | %FileCheck %s --check-prefix=NOTIMING
# NOTIMING: artifacts/launder-scan/contracts.json: timing_environment: the explicit empty TimingEnvironmentContract is absent; an empty timing_contracts array is the absence of the required object, not an instance of it (spec section 2.5.1 and WFInputs item 11)
# NOTIMING: wfinputs binding checks failed
# The surviving empty timing_contracts array is still there and did not rescue it.
# RUN: grep -c '"timing_contracts": \[\]' %t.e/artifacts/launder-scan/contracts.json | %FileCheck %s --check-prefix=STALETC
# STALETC: {{^1$}}

body:             |
  bb.0 (%ir-block.3):
    successors: %bb.4(0x30000000), %bb.1(0x50000000)
    liveins: $w2, $x0, $x1
  
    STRXui $x0, %stack.0, 0 :: (store (s64) into %stack.0)
    renamable $x11 = LDRXui renamable $x1, 0 :: (load (s64) from %ir.1, !tbaa !6)
    renamable $x27 = LDRXui renamable $x1, 1 :: (load (s64) from %ir.5, !tbaa !6)
    renamable $x28 = LDRXui renamable $x1, 2 :: (load (s64) from %ir.7, !tbaa !6)
    renamable $x19 = LDRXui renamable $x1, 3 :: (load (s64) from %ir.9, !tbaa !6)

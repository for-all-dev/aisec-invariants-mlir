    renamable $x26 = LDRXui renamable $x1, 10 :: (load (s64) from %ir.23, !tbaa !6)
    renamable $x10 = LDRXui renamable $x1, 11 :: (load (s64) from %ir.25, !tbaa !6)
    renamable $x9 = LDRXui renamable $x1, 12 :: (load (s64) from %ir.27, !tbaa !6)
    renamable $x12 = LDRXui renamable $x1, 13 :: (load (s64) from %ir.29, !tbaa !6)
    renamable $x13 = LDRXui renamable $x1, 14 :: (load (s64) from %ir.31, !tbaa !6)
    renamable $x0 = LDRXui killed renamable $x1, 15 :: (load (s64) from %ir.33, !tbaa !6)
    STRXui killed renamable $x9, %stack.2, 0 :: (store (s64) into %stack.2)
    STRXui killed renamable $x13, %stack.3, 0 :: (store (s64) into %stack.3)
    STRXui killed renamable $x12, %stack.4, 0 :: (store (s64) into %stack.4)
    STRXui killed renamable $x23, %stack.5, 0 :: (store (s64) into %stack.5)
    STRXui killed renamable $x10, %stack.6, 0 :: (store (s64) into %stack.6)

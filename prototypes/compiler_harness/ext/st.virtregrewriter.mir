    renamable $w14 = ORRWrs $wzr, killed renamable $w2, 0, implicit-def $x14
    STRXui killed renamable $x14, %stack.1, 0 :: (store (s64) into %stack.1)
    renamable $x23 = COPY killed renamable $x8
    B %bb.3
  
  bb.2 (%ir-block.38):
    liveins: $x0, $x11, $x19, $x20, $x21, $x22, $x23, $x24, $x26, $x27, $x28
  
    renamable $x8 = COPY $xzr
    renamable $x9 = EORXrr killed renamable $x27, killed renamable $x19
    renamable $x10 = EORXrr killed renamable $x28, killed renamable $x21
    renamable $x9 = EORXrr killed renamable $x10, killed renamable $x9
    renamable $x10 = EORXrr killed renamable $x20, killed renamable $x22
    renamable $x10 = EORXrr killed renamable $x10, killed renamable $x24
    renamable $x9 = EORXrr killed renamable $x9, killed renamable $x10
    renamable $x10 = LDRXui %stack.5, 0 :: (load (s64) from %stack.5)

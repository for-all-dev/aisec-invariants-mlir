    liveins: $x0, $x8, $x11, $x19, $x20, $x21, $x22, $x24, $x26, $x27, $x28
  
    renamable $x23 = COPY killed renamable $x8
    B %bb.2
  
  bb.1 (%ir-block.36):
    successors: %bb.3(0x80000000)
    liveins: $w2, $x0, $x8, $x11, $x19, $x20, $x21, $x22, $x24, $x26, $x27, $x28
  

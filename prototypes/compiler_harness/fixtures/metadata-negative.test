# CHECK: fixtures/secret-logging-checkpoint/fixed/secret_logging_checkpoint.fixed.mlir: fixture MLIR has no sibling snapshot.yaml
# CHECK: fixtures/alloca-size/high-count-unknown/snapshot.yaml: secret[0] argument index 99 is out of range
# CHECK: fixtures/alloca-size/public-control/snapshot.yaml: c_evidence[0]: path must be normalized and harness-root-relative
# CHECK: fixtures/audience-mismatch/bad/snapshot.yaml: c_evidence[0]: path does not exist
# CHECK: fixtures/audience-mismatch/bad/snapshot.yaml: source-annotated case requires abi.sps.yaml
# CHECK: fixtures/audience-mismatch/bad/snapshot.yaml: source-annotated case c_evidence must name every sibling
# CHECK: fixtures/audience-mismatch/bad/snapshot.yaml: secret[0] name must match argument 0 ('logits')
# CHECK: fixtures/breach-compressed-length/bad/snapshot.yaml: aliases, anchors, and explicit tags are forbidden
# CHECK: fixtures/breach-compressed-length/fixed/snapshot.yaml: aliases, anchors, and explicit tags are forbidden
# CHECK: duplicate key 'format_id'
# CHECK: extra=['extra']
# CHECK: fixtures/explicit-error-oracle/bad/snapshot.yaml
# CHECK-SAME: extra=['valueBytes']
# CHECK: format_id must be 'SPS-Harness-Fixture-Snapshot-v3'
# CHECK: fixtures/prefix-causal-release/bad/snapshot.yaml: wrong fields
# CHECK: fixtures/redis-pool-reuse/bad/snapshot.yaml: snapshot must have exactly one sibling .mlir file

; HAND-AUTHORED FIXTURE SHAPE: temporary bitcode input, not canonical frozen.bc.

define i8 @high_abi_return(i8 %secret) {
entry:
  ret i8 %secret
}

define i8 @constant_abi_return(i8 %secret) {
entry:
  ret i8 7
}

define void @high_pointer_writeback(i8 %secret, ptr %output) {
entry:
  store i8 %secret, ptr %output, align 1
  ret void
}

define void @two_byte_writeback(i8 %secret, ptr %output) {
entry:
  store i8 %secret, ptr %output, align 1
  %second = getelementptr i8, ptr %output, i64 1
  store i8 0, ptr %second, align 1
  ret void
}

define void @uninitialized_terminal_byte(i8 %secret, ptr %output) {
entry:
  store i8 %secret, ptr %output, align 1
  ret void
}

define i8 @one_lane_returns(i1 %secret) {
entry:
  br i1 %secret, label %returns, label %continues

returns:
  ret i8 0

continues:
  br label %continues
}


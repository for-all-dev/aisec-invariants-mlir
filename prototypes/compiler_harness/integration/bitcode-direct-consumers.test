# REQUIRES: aarch64-target, llc, mlir-translate, x86-target
#
# Consume the exact candidate bitcode bytes rather than recompiling their C
# provenance. This binds the level differential to one artifact: branchless
# frozen LLVM, an x86 branch introduced by ISel, and branchless AArch64.

# RUN: %mlir-translate --import-llvm %harness/artifacts/launder-scan/artifact.bc -o %t.mlir
# RUN: %mlir-opt --verify-each %t.mlir -o %t.verified.mlir
# RUN: %FileCheck %s --check-prefix=IR --implicit-check-not=llvm.cond_br --input-file=%t.verified.mlir

# IR-LABEL: llvm.func @launder_scan_model_proved
# IR: llvm.load
# IR: llvm.icmp "ne"
# IR: llvm.select
# IR: llvm.store

# RUN: %llc -mtriple=x86_64-unknown-linux-gnu -O2 %harness/artifacts/launder-scan/artifact.bc -o %t.x86.s
# RUN: %FileCheck %s --check-prefix=X86 --input-file=%t.x86.s

# X86-LABEL: launder_scan_model_proved:
# X86: testl
# X86-NEXT: je
# X86: retq

# RUN: %llc -mtriple=aarch64-unknown-linux-gnu -O2 %harness/artifacts/launder-scan/artifact.bc -o %t.aarch64.s
# RUN: %FileCheck %s --check-prefix=AARCH64 --implicit-check-not='{{(cbz|cbnz|tbz|tbnz|b\.[A-Za-z]+)}}' --input-file=%t.aarch64.s

# AARCH64-LABEL: launder_scan_model_proved:
# AARCH64: ldr
# AARCH64: csel
# AARCH64: str
# AARCH64: ret

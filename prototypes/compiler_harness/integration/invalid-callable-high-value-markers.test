# SHAPE-LABEL: define internal i8 @release_wrong_type(i8 %value)
# SHAPE: call i8 @__sps_invalid_callable_emit_cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# SHAPE-LABEL: define internal void @release_tail_marker(i8 %value)
# SHAPE: tail call void @__sps_invalid_callable_emit_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# SHAPE-LABEL: define internal void @release_varargs_marker(i8 %value)
# SHAPE: call void (i8, ...) @__sps_invalid_callable_emit_dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
# SHAPE-LABEL: define internal void @release_operand_bundle(i8 %value)
# SHAPE: [ "sps.test"() ]
# SHAPE-LABEL: define internal void @release_wrong_cc(i8 %value)
# SHAPE: call fastcc void @__sps_invalid_callable_emit_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
# SHAPE-LABEL: define internal void @release_wrong_value(i8 %value)
# SHAPE: @__sps_invalid_callable_emit_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(i8 0)
# SHAPE-LABEL: define void @release_retry_ordinal(i8 %value)
# SHAPE: call void @release_guarded(i8 %value, i1 false)
# SHAPE-NEXT: call void @release_guarded(i8 %value, i1 true)


# REQUIRES: llvm-as, llvm-dis, opt
#
# INVALID-CARRIER NEGATIVE CORPUS. These 21 wrapper/call cases remain useful as
# rejected alternatives and binding edge cases, but none is an NFv2 release
# carrier. The current carrier is `llvm.sps.release`; ReleaseId is supplied only
# by ReleaseImplementationBindingV2.emitMarkerInstructionId.
#
# RUN: not grep -F '@llvm.sps.release' %harness/integration/Inputs/sps-rev4-high-value/release-markers.ll.in
# RUN: %llvm-as %harness/integration/Inputs/sps-rev4-high-value/release-markers.ll.in -o %t.bc
# RUN: %opt -passes=verify -disable-output %t.bc
# RUN: %llvm-dis %t.bc -o %t.ll
# RUN: %FileCheck %s --check-prefix=SHAPE --input-file=%t.ll
# RUN: %python %harness/tools/check_rev4_high_value_fixtures.py --root %harness --family release-marker | %FileCheck %s --check-prefix=CONTRACT

# SHAPE-LABEL: define internal void @release_conforming(i8 %value)
# SHAPE: call void @__sps_invalid_callable_emit_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa(i8 %value)
# SHAPE-NEXT: ret void
# SHAPE-LABEL: define internal void @release_missing_marker(i8 %value)
# SHAPE-NEXT: entry:
# SHAPE-NEXT: ret void
# SHAPE-LABEL: define internal void @release_duplicate_marker(i8 %value)
# SHAPE: call void @__sps_invalid_callable_emit_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

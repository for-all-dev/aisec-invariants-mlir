# REQUIRES: llc, opt, x86-target
#
# INVALID-CARRIER NEGATIVE EXPERIMENT. Neither carrier in release-markers.ll is the
# SPS-LLVM-NF-v2 release carrier. NFv2 requires the target-independent
# `llvm.sps.release` intrinsic and an external
# ReleaseImplementationBindingV2.emitMarkerInstructionId binding. A callable
# identity function and inline assembly must therefore fail carrier validation
# even when their textual shape survives optimization.
#
# This is not a positive lowering test for NFv2.

# RUN: not grep -F '@llvm.sps.release' %harness/integration/Inputs/release-markers.ll

# RUN: %opt -passes='default<O2>' -S %harness/integration/Inputs/release-markers.ll -o %t.o2.ll
# RUN: %FileCheck %s --check-prefixes=FUNCTION,RETURNED --input-file=%t.o2.ll

# FUNCTION-LABEL: define i32 @function_marker(i32 returned %raw)
# FUNCTION-LABEL: define void @function_user(i32 %raw)
# FUNCTION-NOT: call i32 @function_marker
# FUNCTION: tail call void @sink(i32 %raw)

# `returned` is legal even on the asm input. The asm remains present but its
# result is decorative and the raw value reaches the sink, so the carrier audit
# must reject this attribute explicitly.
# RETURNED-LABEL: define void @asm_returned_bypass(i32 %raw)
# RETURNED: call i32 asm sideeffect
# RETURNED-SAME: i32 returned %raw
# RETURNED-NEXT: tail call void @sink(i32 %raw)

# RUN: %opt -passes='default<O1>' -S %harness/integration/Inputs/release-markers.ll | %FileCheck %s --check-prefix=ASM
# RUN: %opt -passes='default<O2>' -S %harness/integration/Inputs/release-markers.ll | %FileCheck %s --check-prefix=ASM
# RUN: %opt -passes='default<O3>' -S %harness/integration/Inputs/release-markers.ll | %FileCheck %s --check-prefix=ASM
# RUN: %opt -passes='default<Os>' -S %harness/integration/Inputs/release-markers.ll | %FileCheck %s --check-prefix=ASM
# RUN: %opt -passes='default<Oz>' -S %harness/integration/Inputs/release-markers.ll | %FileCheck %s --check-prefix=ASM

# ASM-LABEL: define void @asm_user(i32 %raw)
# ASM: %[[RELEASED:.*]] = tail call i32 asm sideeffect "# sps.declassify id=$2", "=r,0,i,~{memory}"(i32 %raw, i32 7)
# ASM-NEXT: tail call void @sink(i32 %[[RELEASED]])

# The marker is present in optimized IR and emitted assembly, but assembler
# comments do not survive into the object. This pins the capture point above the
# object/binary and prevents a later consumer from assuming it can recover IDs.
# RUN: %llc -O2 %t.o2.ll -o %t.s
# RUN: grep -F 'sps.declassify id=' %t.s
# RUN: %llc -O2 -filetype=obj %t.o2.ll -o %t.o
# RUN: not grep -a -F 'sps.declassify' %t.o

# REQUIRES: clang, x86-target
#
# Runtime coverage proves these C bodies execute, but their intended source
# evidence also includes alias-sensitive accesses, actual VLA size, operation
# count, predecessor choice, byte offsets, distinct actor sink arguments, and
# prefix order. Pin those shapes at the provenance boundary without treating
# them as ABI topology, policy semantics, or a ModelStatus; the sidecar checks
# bind those higher-level facts separately.

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/abi-alias/sources/abi_alias_unproved.c -o %t.alias.ll
# RUN: %FileCheck %s --check-prefix=ALIAS --implicit-check-not=noalias --input-file=%t.alias.ll

# ALIAS-LABEL: define{{.*}} @abi_alias_missing_binding(
# ALIAS: %[[SECRET:.*]] = load i32, ptr %secret.addr
# ALIAS: %[[P:.*]] = load ptr, ptr %p.addr
# ALIAS-NEXT: store i32 %[[SECRET]], ptr %[[P]]
# ALIAS: %[[Q:.*]] = load ptr, ptr %q.addr
# ALIAS-NEXT: %[[VALUE:.*]] = load i32, ptr %[[Q]]
# ALIAS: %[[OUT:.*]] = load ptr, ptr %public_output.addr
# ALIAS-NEXT: store i32 %[[VALUE]], ptr %[[OUT]]
# ALIAS-LABEL: define{{.*}} @abi_alias_mayalias_overlap(
# ALIAS: %[[M_SECRET:.*]] = load i32, ptr %secret.addr
# ALIAS: %[[M_P:.*]] = load ptr, ptr %p.addr
# ALIAS-NEXT: store i32 %[[M_SECRET]], ptr %[[M_P]]
# ALIAS: %[[M_Q:.*]] = load ptr, ptr %q.addr
# ALIAS-NEXT: %[[M_VALUE:.*]] = load i32, ptr %[[M_Q]]
# ALIAS: %[[M_OUT:.*]] = load ptr, ptr %public_output.addr
# ALIAS-NEXT: store i32 %[[M_VALUE]], ptr %[[M_OUT]]
# ALIAS-LABEL: define{{.*}} @abi_alias_disjoint_control(
# ALIAS: %[[D_SECRET:.*]] = load i32, ptr %secret.addr
# ALIAS: %[[D_P:.*]] = load ptr, ptr %p.addr
# ALIAS-NEXT: store i32 %[[D_SECRET]], ptr %[[D_P]]
# ALIAS: %[[D_Q:.*]] = load ptr, ptr %q.addr
# ALIAS-NEXT: %[[D_VALUE:.*]] = load i32, ptr %[[D_Q]]
# ALIAS: %[[D_OUT:.*]] = load ptr, ptr %public_output.addr
# ALIAS-NEXT: store i32 %[[D_VALUE]], ptr %[[D_OUT]]

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/alloca-size/sources/alloca_size_models.c -o %t.alloca.ll
# RUN: %FileCheck %s --check-prefixes=ALLOCA-HIGH,ALLOCA-PUBLIC --input-file=%t.alloca.ll

# ALLOCA-HIGH-LABEL: define{{.*}} @alloca_size_high_count(
# ALLOCA-HIGH: %[[SECRET:.*]] = load i32, ptr %secret_bit.addr
# ALLOCA-HIGH-NEXT: %[[IS_SET:.*]] = icmp ne i32 %[[SECRET]], 0
# ALLOCA-HIGH: %[[COND:.*]] = select i1 %[[IS_SET]], i32 64, i32 128
# ALLOCA-HIGH: store i32 %[[COND]], ptr %count
# ALLOCA-HIGH: %[[COUNT32:.*]] = load i32, ptr %count
# ALLOCA-HIGH: %[[COUNT64:.*]] = zext i32 %[[COUNT32]] to i64
# ALLOCA-HIGH: %vla = alloca i8, i64 %[[COUNT64]]
# ALLOCA-HIGH: store volatile ptr %vla, ptr @scratch_escape

# ALLOCA-PUBLIC-LABEL: define{{.*}} @alloca_size_public_control(
# ALLOCA-PUBLIC: %[[PUBLIC32:.*]] = load i32, ptr %public_count.addr
# ALLOCA-PUBLIC-NEXT: %[[PUBLIC64:.*]] = zext i32 %[[PUBLIC32]] to i64
# ALLOCA-PUBLIC: %vla = alloca i8, i64 %[[PUBLIC64]]
# ALLOCA-PUBLIC: store volatile ptr %vla, ptr @scratch_escape

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/audience-mismatch/sources/audience_mismatch_bad.c -o %t.audience.ll
# RUN: %FileCheck %s --check-prefix=AUDIENCE --input-file=%t.audience.ll

# AUDIENCE-LABEL: define{{.*}} @audience_mismatch_bad(
# AUDIENCE: %[[LOGITS:.*]] = load i32, ptr %logits.addr
# AUDIENCE-NEXT: %[[RELEASED:.*]] = call i32 @sps_release_masked_class_candidate(i32 {{.*}}%[[LOGITS]])
# AUDIENCE-NEXT: store i32 %[[RELEASED]], ptr %released
# AUDIENCE-NEXT: %[[ALICE_VALUE:.*]] = load i32, ptr %released
# AUDIENCE-NEXT: %[[ALICE:.*]] = load ptr, ptr %alice_channel.addr
# AUDIENCE-NEXT: store i32 %[[ALICE_VALUE]], ptr %[[ALICE]]
# AUDIENCE-NEXT: %[[BOB_VALUE:.*]] = load i32, ptr %released
# AUDIENCE-NEXT: %[[BOB:.*]] = load ptr, ptr %bob_channel.addr
# AUDIENCE-NEXT: store i32 %[[BOB_VALUE]], ptr %[[BOB]]

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/loop-bounds/sources/bound_exhausted_loop.c -o %t.bound.ll
# RUN: %FileCheck %s --check-prefix=BOUND --input-file=%t.bound.ll

# BOUND-LABEL: define{{.*}} @bound_secret_trip_count_bad(
# BOUND: %[[SECRET_I:.*]] = load i32, ptr %i
# BOUND-NEXT: %[[SECRET_COUNT:.*]] = load i32, ptr %secret_count.addr
# BOUND-NEXT: %[[SECRET_CMP:.*]] = icmp slt i32 %[[SECRET_I]], %[[SECRET_COUNT]]
# BOUND-NEXT: br i1 %[[SECRET_CMP]]
# BOUND-LABEL: define{{.*}} @bound_exhausted_public_loop(
# BOUND: %[[PUBLIC_I:.*]] = load i32, ptr %i
# BOUND-NEXT: %[[PUBLIC_COUNT:.*]] = load i32, ptr %public_count.addr
# BOUND-NEXT: %[[PUBLIC_CMP:.*]] = icmp slt i32 %[[PUBLIC_I]], %[[PUBLIC_COUNT]]
# BOUND-NEXT: br i1 %[[PUBLIC_CMP]]

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/precision-control/sources/precision_controls.c -o %t.precision.ll
# RUN: %FileCheck %s --check-prefix=PRECISION --input-file=%t.precision.ll

# PRECISION-LABEL: define{{.*}} @identical_successor_control(
# PRECISION: %[[HIGH:.*]] = load i32, ptr %high_condition.addr
# PRECISION-NEXT: %[[HIGH_COND:.*]] = icmp ne i32 %[[HIGH]], 0
# PRECISION-NEXT: br i1 %[[HIGH_COND]], label %if.then, label %if.end
# PRECISION: if.then:
# PRECISION-NEXT: br label %if.end
# PRECISION: %[[PUBLIC_RESULT:.*]] = load i32, ptr %public_value.addr
# PRECISION-NEXT: ret i32 %[[PUBLIC_RESULT]]
# PRECISION-LABEL: define{{.*}} @xor_cancellation_control(
# PRECISION: %[[XOR_LEFT:.*]] = load i32, ptr %secret.addr
# PRECISION-NEXT: %[[XOR_RIGHT:.*]] = load i32, ptr %secret.addr
# PRECISION-NEXT: %[[CANCELLED:.*]] = xor i32 %[[XOR_LEFT]], %[[XOR_RIGHT]]
# PRECISION-NEXT: ret i32 %[[CANCELLED]]
# PRECISION-LABEL: define{{.*}} @overwritten_slot_control(
# PRECISION: %[[SLOT_SECRET:.*]] = load i32, ptr %secret.addr
# PRECISION-NEXT: store i32 %[[SLOT_SECRET]], ptr %slot
# PRECISION-NEXT: %[[SLOT_PUBLIC:.*]] = load i32, ptr %public_value.addr
# PRECISION-NEXT: store i32 %[[SLOT_PUBLIC]], ptr %slot
# PRECISION-NEXT: %[[SLOT_RESULT:.*]] = load i32, ptr %slot
# PRECISION-NEXT: ret i32 %[[SLOT_RESULT]]
# PRECISION-LABEL: define{{.*}} @offset_disjoint_control(
# PRECISION: %[[BYTE_SECRET:.*]] = load i32, ptr %secret_byte.addr
# PRECISION-NEXT: %[[BYTE_SECRET8:.*]] = trunc i32 %[[BYTE_SECRET]] to i8
# PRECISION: %[[BUFFER4:.*]] = load ptr, ptr %buffer.addr
# PRECISION-NEXT: %[[ADDRESS4:.*]] = getelementptr inbounds i8, ptr %[[BUFFER4]], i64 4
# PRECISION-NEXT: store i8 %[[BYTE_SECRET8]], ptr %[[ADDRESS4]]
# PRECISION: %[[BYTE_PUBLIC:.*]] = load i32, ptr %public_value.addr
# PRECISION-NEXT: %[[BYTE_PUBLIC8:.*]] = trunc i32 %[[BYTE_PUBLIC]] to i8
# PRECISION: %[[BUFFER8:.*]] = load ptr, ptr %buffer.addr
# PRECISION-NEXT: %[[ADDRESS8:.*]] = getelementptr inbounds i8, ptr %[[BUFFER8]], i64 8
# PRECISION-NEXT: store i8 %[[BYTE_PUBLIC8]], ptr %[[ADDRESS8]]
# PRECISION: %[[RELOAD_BUFFER:.*]] = load ptr, ptr %buffer.addr
# PRECISION-NEXT: %[[RELOAD_ADDRESS:.*]] = getelementptr inbounds i8, ptr %[[RELOAD_BUFFER]], i64 8
# PRECISION-NEXT: %[[RELOADED:.*]] = load i8, ptr %[[RELOAD_ADDRESS]]

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/predecessor-choice/sources/predecessor_choice_blockarg_bad.c -o %t.predecessor.ll
# RUN: %FileCheck %s --check-prefix=PREDECESSOR --input-file=%t.predecessor.ll

# PREDECESSOR-LABEL: define{{.*}} @predecessor_choice_blockarg_bad(
# PREDECESSOR: %[[SECRET:.*]] = load i32, ptr %secret_bit.addr
# PREDECESSOR-NEXT: %[[CHOICE:.*]] = icmp ne i32 %[[SECRET]], 0
# PREDECESSOR-NEXT: br i1 %[[CHOICE]], label %if.then, label %if.else
# PREDECESSOR: store i32 10, ptr %selected
# PREDECESSOR: store i32 20, ptr %selected
# PREDECESSOR: load i32, ptr %selected

# RUN: %clang -std=c11 -Wall -Wextra -Wpedantic -Werror -fno-builtin -fno-discard-value-names --target=x86_64-unknown-linux-gnu -O0 -Xclang -disable-O0-optnone -S -emit-llvm %fixtures/prefix-causal-release/sources/prefix_causal_release_bad.c -o %t.prefix.ll
# RUN: %FileCheck %s --check-prefix=PREFIX --input-file=%t.prefix.ll

# PREFIX-LABEL: define{{.*}} @prefix_causal_release_bad(
# PREFIX: store i32 %secret, ptr %secret.addr
# PREFIX: %[[SECRET:.*]] = load i32, ptr %secret.addr
# PREFIX: %[[CHANNEL:.*]] = load ptr, ptr %public_channel.addr
# PREFIX-NEXT: store i32 %[[SECRET]], ptr %[[CHANNEL]]
# PREFIX: %[[RELEASE_INPUT:.*]] = load i32, ptr %secret.addr
# PREFIX-NEXT: call i32 @sps_release_policy_h_candidate(i32 {{.*}}%[[RELEASE_INPUT]])

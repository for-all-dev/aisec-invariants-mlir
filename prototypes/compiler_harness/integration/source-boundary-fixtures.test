# REQUIRES: clang, clang-tooling, llvm-config
#
# Every annotated fixture case owns its primary source, policy, and ABI. Run
# the real Clang AST resolver for every source-boundary pipeline assigned to
# this test, then let the ordinary checkpoint finalizer prove that no declared
# case was silently skipped.

# RUN: %python %harness/integration/Inputs/run_source_boundary_fixtures.py --checkpoint-pipeline source-boundary --root %harness --records %t.checkpoints --outputs %t.outputs --clang %clang --llvm-config %llvm_bin/llvm-config
# RUN: %checkpoint-runner finalize --test integration/source-boundary-fixtures.test --records %t.checkpoints

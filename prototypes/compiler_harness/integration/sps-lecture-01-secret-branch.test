# REQUIRES: llvm-as, llvm-dis
# RUN: %llvm-as %harness/integration/Inputs/sps-lecture/01-secret-branch/capture-shape.ll -o %t.bc
# RUN: %llvm-dis %t.bc -o %t.ll
# RUN: %FileCheck %s --check-prefix=SHAPE --input-file=%t.ll
# RUN: %python %harness/tools/check_sps_lecture_cases.py --root %harness --case 01-secret-branch | %FileCheck %s --check-prefix=CONTRACT

# SHAPE-LABEL: define i8 @fixture_entry(i8 %secret)
# SHAPE: br i1 %is_zero, label %zero, label %nonzero
# SHAPE: %private = phi i8
# SHAPE: ret i8 %private
# SHAPE-NOT: global

# CONTRACT: verified 01-secret-branch: fixture-contract only; claimable=false; ModelStatus=not-computed; expected=Counterexample

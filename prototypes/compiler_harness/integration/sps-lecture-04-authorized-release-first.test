# SHAPE-LABEL: define internal void @release_secret(i8 %value)
# SHAPE: call void (...) @llvm.sps.release(i8 %value)
# SHAPE-LABEL: define i8 @fixture_entry(i8 %secret)
# SHAPE: call void @release_secret(i8 %secret)
# SHAPE: br i1 %is_zero
# SHAPE: ret i8 %private


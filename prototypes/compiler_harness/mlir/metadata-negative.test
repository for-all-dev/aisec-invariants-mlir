# The snapshot catalog is one closed, human-readable schema. YAML shortcuts,
# stale argument references, orphaned files, and premature SPS claims fail
# before any semantic claim.

# RUN: rm -rf %t.root
# RUN: mkdir -p %t.root
# RUN: cp -R %harness/c %t.root/c
# RUN: mkdir -p %t.root/tools
# RUN: cp %harness/tools/sps_aggregation.py %t.root/tools/sps_aggregation.py
# RUN: cp -R %harness/mlir %t.root/mlir

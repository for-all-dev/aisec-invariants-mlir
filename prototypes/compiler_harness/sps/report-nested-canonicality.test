# NESTED CANONICALITY OF THE MACHINE REPORT.
#
# sps/report-schema.test pins the top-level SPSRunReportV1 envelope. This test
# pins everything *below* it: the section-19 nested records
# (PublicQueryScheduleV1, QueryDescriptorV1, PublicQueryResultRowV1,
# ReleasePolicyReviewReportV1, ReleasePolicyLintV1), the exact query scope
# matrix, CanonicalPublicQueryScheduleDigestV1, one-result-row-per-schedule
# ordinal, and the exact ReleasePolicyLintV1 list.
#
# WHAT THIS DOES NOT CHECK. Nothing here parses bitcode, establishes
# NFConforms, replays a witness, or resolves a receipt against a restricted
# store. The fixtures are synthetic aaaa.../cccc... records; a passing arm says
# the bytes are a well-formed report, never that any ModelStatus was computed.
# The lint expectations are DERIVED by the checker from the declared visibility
# bases and release audiences in sps/Inputs/lecture-policy-release.json using
# the specification section 12 predicates; no lecture expected.logical.yaml
# scope tuple is mirrored.

# --- positive arms ---------------------------------------------------------
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %S/Inputs/report-proved.json | %FileCheck %s --check-prefix=PROVED
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --case 04-authorized-release-first --report %S/Inputs/report-findings.json | %FileCheck %s --check-prefix=FINDINGS

# PROVED: verified 02-branchless-repair: canonical CompletedV1 SPSRunReportV1
# FINDINGS: verified 04-authorized-release-first: canonical CompletedV1 SPSRunReportV1

# The case-04 shape is pinned as positive cardinalities, so an empty schedule,
# an empty result list, or a silently dropped lint cannot pass by vacuity.
# RUN: %python -c "import json,pathlib; r=json.loads(pathlib.Path(r'%S/Inputs/report-findings.json').read_text())['report']; v=r['releasePolicyReview']; print('COUNTS', len(r['querySchedule']['queries']), len(r['queryResults']), len(v['summands']), len(v['totals']), len(v['lints']))" | %FileCheck %s --check-prefix=COUNTS
# COUNTS: COUNTS 3 3 3 3 2

# The two derived lints are exactly the empty and observer coalitions. The
# owner coalition sees `secret` (policy componentVisibility.memberVisible), so
# Class_owner(secret)=Low and IdentityReleaseOfHigh cannot fire for it.
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; lints=json.loads(pathlib.Path(r'%S/Inputs/report-findings.json').read_text())['report']['releasePolicyReview']['lints']; print('OWNERCOUNT', sum(1 for l in lints if l['coalitionScope']['coalitionId']==C.coalition_id(['owner']))); print('OBSERVERCOUNT', sum(1 for l in lints if l['coalitionScope']['coalitionId']==C.coalition_id(['observer'])))" | %FileCheck %s --check-prefix=SCOPES
# SCOPES: OWNERCOUNT 0
# SCOPES: OBSERVERCOUNT 1

# --- negative: an empty object is not a PublicQueryScheduleV1 ---------------
# This is the exact hole that let every fixture ship "querySchedule":{}.
# RUN: cp %S/Inputs/report-proved.json %t.empty-schedule.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.empty-schedule.json'); v=json.loads(p.read_text()); v['report']['querySchedule']={}; v['report']['queryScheduleDigest']=C.canonical_digest({}); p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.empty-schedule.json 2>&1 | %FileCheck %s --check-prefix=EMPTY-SCHEDULE
# EMPTY-SCHEDULE: SPSRunReportV1 CompletedV1.report.querySchedule fields/order mismatch: ()

# --- negative: scrambled nested field order ---------------------------------
# The old checker re-serialized the PARSED dict, so authored order always
# matched itself. The rebuild is now schema-ordered, and the recursive exact-key
# pass rejects the scramble before serialization is even compared.
# RUN: cp %S/Inputs/report-proved.json %t.scrambled.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.scrambled.json'); v=json.loads(p.read_text()); s=v['report']['querySchedule']; v['report']['querySchedule']={'queries':s['queries'],'proofConfigurationDigest':s['proofConfigurationDigest'],'formatId':s['formatId'],'artifactIdentityDigest':s['artifactIdentityDigest']}; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.scrambled.json 2>&1 | %FileCheck %s --check-prefix=SCRAMBLED
# SCRAMBLED: SPSRunReportV1 CompletedV1.report.querySchedule fields/order mismatch: ('queries', 'proofConfigurationDigest', 'formatId', 'artifactIdentityDigest')

# --- negative: unknown field on a deeply nested record ----------------------
# RUN: cp %S/Inputs/report-proved.json %t.unknown-field.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.unknown-field.json'); v=json.loads(p.read_text()); v['report']['querySchedule']['queries'][0]['zzz_unknown_field']=1; v['report']['queryScheduleDigest']=C.canonical_digest(v['report']['querySchedule']); p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.unknown-field.json 2>&1 | %FileCheck %s --check-prefix=UNKNOWN-FIELD
# UNKNOWN-FIELD: querySchedule.queries[0] fields/order mismatch: {{.*}}'zzz_unknown_field'

# --- negative: an unknown field on releasePolicyReview ----------------------
# The old checker accepted releasePolicyReview as a one-field {"status":...}
# object, so a WRONG formatId plus an unknown field was invisible.
# RUN: cp %S/Inputs/report-proved.json %t.bad-review.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.bad-review.json'); v=json.loads(p.read_text()); v['report']['releasePolicyReview']={'status':{'tag':'Complete'},'zzz_unknown_field':1,'formatId':'WRONG'}; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.bad-review.json 2>&1 | %FileCheck %s --check-prefix=BAD-REVIEW
# BAD-REVIEW: releasePolicyReview fields/order mismatch: ('status', 'zzz_unknown_field', 'formatId')

# --- negative: duplicate key inside a nested record -------------------------
# RUN: %python -c "import pathlib; p=pathlib.Path(r'%S/Inputs/report-proved.json'); pathlib.Path(r'%t.duplicate.json').write_text(p.read_text().replace('\"queryOrdinal\":0,', '\"queryOrdinal\":0,\"queryOrdinal\":0,', 1))"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.duplicate.json 2>&1 | %FileCheck %s --check-prefix=DUPLICATE
# DUPLICATE: duplicate JSON field: queryOrdinal

# --- negative: schedule/result ordinal disagreement -------------------------
# RUN: cp %S/Inputs/report-proved.json %t.ordinals.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.ordinals.json'); v=json.loads(p.read_text()); del v['report']['queryResults'][2]; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.ordinals.json 2>&1 | %FileCheck %s --check-prefix=ORDINALS
# ORDINALS: queryResults has 2 rows for 3 scheduled descriptors

# RUN: cp %S/Inputs/report-proved.json %t.renumber.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.renumber.json'); v=json.loads(p.read_text()); v['report']['queryResults'][1]['queryOrdinal']=2; v['report']['queryResults'][2]['queryOrdinal']=1; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.renumber.json 2>&1 | %FileCheck %s --check-prefix=RENUMBER
# RENUMBER: queryResults[1].queryOrdinal is 2; rows must appear in numeric schedule-ordinal order

# --- negative: the schedule is not ordered by canonical scope bytes ---------
# RUN: cp %S/Inputs/report-proved.json %t.unordered.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.unordered.json'); v=json.loads(p.read_text()); s=v['report']['querySchedule']; s['queries']=list(reversed(s['queries'])); v['report']['queryScheduleDigest']=C.canonical_digest(s); p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.unordered.json 2>&1 | %FileCheck %s --check-prefix=UNORDERED
# UNORDERED: querySchedule.queries is not ordered by QueryKindV1 ordinal then canonical scope bytes

# --- negative: the AuditAll row of the scope matrix -------------------------
# AuditAll is exactly (entry, concrete coalition); every other option is None.
# RUN: cp %S/Inputs/report-proved.json %t.scope.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.scope.json'); v=json.loads(p.read_text()); s=v['report']['querySchedule']; s['queries'][0]['releaseScope']={'tag':'Some','value':'q.secret'}; v['report']['queryScheduleDigest']=C.canonical_digest(s); p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.scope.json 2>&1 | %FileCheck %s --check-prefix=SCOPE
# SCOPE: querySchedule.queries[0] violates the AuditAll scope matrix: releaseScope must be None

# --- negative: unrepaired CanonicalPublicQueryScheduleDigestV1 --------------
# RUN: cp %S/Inputs/report-proved.json %t.digest.json
# The schedule content moves (every descriptor is rebound to another entry) but
# the recorded digest is left alone, so the binding has to catch it.
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.digest.json'); v=json.loads(p.read_text()); [q.__setitem__('entryScope',{'tag':'Some','value':'fixture_entry_relabelled'}) for q in v['report']['querySchedule']['queries']]; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.digest.json 2>&1 | %FileCheck %s --check-prefix=DIGEST
# DIGEST: queryScheduleDigest is not CanonicalPublicQueryScheduleDigestV1(querySchedule)

# --- negative: the rebuild still owns serialization form --------------------
# Field order is legal here; only the whitespace is not. This arm is what keeps
# the schema-ordered rebuild comparison load-bearing.
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%S/Inputs/report-proved.json'); pathlib.Path(r'%t.pretty.json').write_text(json.dumps(json.loads(p.read_text()),indent=2)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.pretty.json 2>&1 | %FileCheck %s --check-prefix=PRETTY
# PRETTY: report is not compact canonical JSON or has noncanonical field order

# --- negative: Complete with a nonempty lint list ---------------------------
# Specification section 19: the status is Complete iff lints == [].
# RUN: cp %S/Inputs/report-findings.json %t.complete-with-lints.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.complete-with-lints.json'); v=json.loads(p.read_text()); v['report']['policyReviewStatus']={'tag':'Complete'}; v['report']['releasePolicyReview']['status']={'tag':'Complete'}; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 04-authorized-release-first --report %t.complete-with-lints.json 2>&1 | %FileCheck %s --check-prefix=COMPLETE-WITH-LINTS
# COMPLETE-WITH-LINTS: PolicyReviewStatus Complete requires lints == []

# The converse smuggle: a case whose derived lint set is empty keeps status
# Complete but carries a lint row anyway. Nothing in the old checker looked at
# releasePolicyReview.lints at all, so this passed.
# RUN: cp %S/Inputs/report-proved.json %t.smuggled-lint.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.smuggled-lint.json'); v=json.loads(p.read_text()); v['report']['releasePolicyReview']['lints']=[{'lintClass':'ExpectedVariableDeclaredWorldVisible','entryScope':{'tag':'Some','value':'fixture_entry'},'coalitionScope':{'tag':'ConcreteCoalition','coalitionId':C.coalition_id(['observer'])},'releaseScope':{'tag':'None'},'componentScope':{'tag':'Some','value':'secret'}}]; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.smuggled-lint.json 2>&1 | %FileCheck %s --check-prefix=SMUGGLED-LINT
# SMUGGLED-LINT: releasePolicyReview.lints is not the exact ordered lint set derived from the policy and release declarations: expected 0 row(s), got 1

# --- negative: an illegal owner lint plus an unrequested extra lint ---------
# This is the case the old SUBSET test accepted with rc=0: the required class
# was present, so two spurious rows rode along. Findings(S) now holds only when
# S is EXACTLY the derived set.
# RUN: cp %S/Inputs/report-findings.json %t.extra-lints.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.extra-lints.json'); v=json.loads(p.read_text()); lints=v['report']['releasePolicyReview']['lints']; lints.append({'lintClass':'IdentityReleaseOfHigh','entryScope':{'tag':'Some','value':'fixture_entry'},'coalitionScope':{'tag':'ConcreteCoalition','coalitionId':C.coalition_id(['owner'])},'releaseScope':{'tag':'Some','value':'q.secret'},'componentScope':{'tag':'Some','value':'secret'}}); lints.append({'lintClass':'CoalitionEntryTotalOverThreshold','entryScope':{'tag':'Some','value':'fixture_entry'},'coalitionScope':{'tag':'ConcreteCoalition','coalitionId':C.coalition_id([])},'releaseScope':{'tag':'None'},'componentScope':{'tag':'None'}}); v['report']['policyReviewStatus']={'tag':'Findings','args':[lints]}; v['report']['releasePolicyReview']['status']=v['report']['policyReviewStatus']; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 04-authorized-release-first --report %t.extra-lints.json 2>&1 | %FileCheck %s --check-prefix=EXTRA-LINTS
# EXTRA-LINTS: releasePolicyReview.lints is not the exact ordered lint set derived from the policy and release declarations: expected 2 row(s), got 4

# --- negative: a capacity lint that the report owes but does not carry ------
# CoalitionEntryTotalOverThreshold is defined over the report's own total rows,
# so raising a total above the declared 64-bit threshold obliges a new lint.
# RUN: cp %S/Inputs/report-findings.json %t.over-threshold.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.over-threshold.json'); v=json.loads(p.read_text()); v['report']['releasePolicyReview']['totals'][0]['totalBits']=4096; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 04-authorized-release-first --report %t.over-threshold.json 2>&1 | %FileCheck %s --check-prefix=OVER-THRESHOLD
# OVER-THRESHOLD: releasePolicyReview.lints is not the exact ordered lint set derived from the policy and release declarations: expected 3 row(s), got 2

# --- negative: the AuditAll rows must agree with the case catalog -----------
# RUN: cp %S/Inputs/report-proved.json %t.solver.json
# RUN: %python -c "import json,pathlib,sys; sys.path.insert(0,r'%harness/tools'); import check_sps_run_report as C; p=pathlib.Path(r'%t.solver.json'); v=json.loads(p.read_text()); v['report']['queryResults'][0]['outcome']['args'][0]['rawSolverResult']='SAT'; p.write_text(C.canonical_text(v)+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 02-branchless-repair --report %t.solver.json 2>&1 | %FileCheck %s --check-prefix=SOLVER
# SOLVER: queryResults[0] rawSolverResult 'SAT' disagrees with the case matcher 'UNSAT'

# THE TWO SPSRunReportV1 ARMS THAT ISSUE NO MODEL STATUS.
#
# Every verifier invocation emits exactly one SPSRunReportV1. Two of its three
# constructors are refusals: ConfigurationRejectedV1 is used before a complete
# canonical ArtifactIdentityV1 and ProofConfigurationV1 can even be bound, and
# ReportingFailedV1 is used after identity binding when the restricted-store
# prerequisite, slot reservation, or bundle finalization fails. Both carry the
# literal disposition "NoModelStatus", and the specification is explicit that
# they contain no input-derived digest, path, parser message, byte count,
# receipt, or ModelStatus. That refusal boundary is the harness's own safety
# property, so it is tested here rather than assumed.
#
# WHAT THIS DOES NOT CHECK. These fixtures are hand-written JSON. No verifier
# ran, no bitcode was parsed, and no NFConforms or ModelStatus is asserted by
# any arm below - the whole point of both records is that no model status
# exists to assert. This is a wire-format and refusal-shape test only.

# --- positive: three ConfigurationRejectionReasonV1 constructors ------------
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %S/Inputs/reject-noncanonical-interface.json | %FileCheck %s --check-prefix=REJECT-NONCANONICAL
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %S/Inputs/reject-artifact-parse-failure.json | %FileCheck %s --check-prefix=REJECT-PARSE
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %S/Inputs/reject-insufficient-evidence-capacity.json | %FileCheck %s --check-prefix=REJECT-CAPACITY

# REJECT-NONCANONICAL: verified ConfigurationRejectedV1: disposition NoModelStatus, reason NoncanonicalInterface
# REJECT-PARSE: verified ConfigurationRejectedV1: disposition NoModelStatus, reason ArtifactParseFailure
# REJECT-CAPACITY: verified ConfigurationRejectedV1: disposition NoModelStatus, reason InsufficientEvidenceCapacity

# --- positive: both SPSReportingFailureReasonV1 constructors ----------------
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ReportingFailedV1 --report %S/Inputs/failure-restricted-store-unavailable.json | %FileCheck %s --check-prefix=FAIL-STORE
# RUN: %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ReportingFailedV1 --report %S/Inputs/failure-evidence-finalization.json | %FileCheck %s --check-prefix=FAIL-FINALIZE

# FAIL-STORE: verified ReportingFailedV1: disposition NoModelStatus, reason RestrictedStoreUnavailable
# FAIL-FINALIZE: verified ReportingFailedV1: disposition NoModelStatus, reason EvidenceFinalizationFailure

# Both refusal records are exactly three fields. Pinned as a positive count so
# that an accidentally emptied fixture cannot pass the arms above by vacuity.
# RUN: %python -c "import json,pathlib; print('FIELDS', *(len(json.loads(pathlib.Path(p).read_text())['report']) for p in [r'%S/Inputs/reject-noncanonical-interface.json', r'%S/Inputs/failure-restricted-store-unavailable.json']))" | %FileCheck %s --check-prefix=FIELDS
# FIELDS: FIELDS 3 3

# --- negative: the default arm stays CompletedV1-only ----------------------
# Existing callers pass no --expect-arm, so a refusal must not be mistaken for
# a completed run, and a completed run must not satisfy a refusal expectation.
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --case 01-secret-branch --report %S/Inputs/reject-noncanonical-interface.json 2>&1 | %FileCheck %s --check-prefix=DEFAULT-ARM
# DEFAULT-ARM: expected SPSRunReportV1 arm CompletedV1, got 'ConfigurationRejectedV1'

# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ReportingFailedV1 --report %S/Inputs/report-proved.json 2>&1 | %FileCheck %s --check-prefix=WRONG-ARM
# WRONG-ARM: expected SPSRunReportV1 arm ReportingFailedV1, got 'CompletedV1'

# --- negative: no refusal may carry a modelStatus --------------------------
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.modelstatus.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-noncanonical-interface.json').read_text()); v['report']['modelStatus']={'tag':'Proved'}; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.modelstatus.json 2>&1 | %FileCheck %s --check-prefix=NO-MODEL-STATUS
# NO-MODEL-STATUS: ConfigurationRejectedV1 must not carry an input-derived or status-bearing 'modelStatus' field (report.modelStatus)

# The same rule holds after identity binding.
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.failure-modelstatus.json'); v=json.loads(pathlib.Path(r'%S/Inputs/failure-restricted-store-unavailable.json').read_text()); v['report']['modelStatus']={'tag':'Unknown','args':[{'reasonClassId':'ManifestMismatch'}]}; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ReportingFailedV1 --report %t.failure-modelstatus.json 2>&1 | %FileCheck %s --check-prefix=FAIL-NO-MODEL-STATUS
# FAIL-NO-MODEL-STATUS: ReportingFailedV1 must not carry an input-derived or status-bearing 'modelStatus' field (report.modelStatus)

# --- negative: no digest, path, receipt, or byte count ---------------------
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.digest.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-artifact-parse-failure.json').read_text()); v['report']['artifactIdentityDigest']='a'*64; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.digest.json 2>&1 | %FileCheck %s --check-prefix=NO-DIGEST
# NO-DIGEST: ConfigurationRejectedV1 must not carry an input-derived or status-bearing 'artifactIdentityDigest' field (report.artifactIdentityDigest)

# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.receipt.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-artifact-parse-failure.json').read_text()); v['report']['evidence']={'runReceipt':'c'*64}; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.receipt.json 2>&1 | %FileCheck %s --check-prefix=NO-RECEIPT
# NO-RECEIPT: ConfigurationRejectedV1 must not carry a digest- or receipt-shaped value (report.evidence.runReceipt)

# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.path.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-artifact-parse-failure.json').read_text()); v['report']['path']='/tmp/candidate.bc'; v['report']['byteCount']=4096; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.path.json 2>&1 | %FileCheck %s --check-prefix=NO-PATH
# NO-PATH: ConfigurationRejectedV1 must not carry an input-derived or status-bearing 'path' field (report.path)

# --- negative: disposition is the literal "NoModelStatus" ------------------
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.disposition.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-noncanonical-interface.json').read_text()); v['report']['disposition']='ModelStatusWithheld'; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.disposition.json 2>&1 | %FileCheck %s --check-prefix=DISPOSITION
# DISPOSITION: report.disposition must be the literal 'NoModelStatus', got 'ModelStatusWithheld'

# --- negative: the reason enumerations are closed --------------------------
# A reason invented by an implementation, or borrowed from the other refusal
# arm, is not a member of either closed constructor list.
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.reason.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-noncanonical-interface.json').read_text()); v['report']['reason']={'tag':'SolverTimeout'}; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.reason.json 2>&1 | %FileCheck %s --check-prefix=REASON
# REASON: report.reason tag 'SolverTimeout' is outside the closed ConfigurationRejectionReasonV1 constructors

# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.crossed-reason.json'); v=json.loads(pathlib.Path(r'%S/Inputs/failure-restricted-store-unavailable.json').read_text()); v['report']['reason']={'tag':'ArtifactParseFailure'}; p.write_text(json.dumps(v,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ReportingFailedV1 --report %t.crossed-reason.json 2>&1 | %FileCheck %s --check-prefix=CROSSED-REASON
# CROSSED-REASON: report.reason tag 'ArtifactParseFailure' is outside the closed SPSReportingFailureReasonV1 constructors

# --- negative: the refusal records are still canonical JSON ----------------
# RUN: %python -c "import json,pathlib; p=pathlib.Path(r'%t.scrambled.json'); v=json.loads(pathlib.Path(r'%S/Inputs/reject-noncanonical-interface.json').read_text())['report']; out={'tag':'ConfigurationRejectedV1','report':{'reason':v['reason'],'formatId':v['formatId'],'disposition':v['disposition']}}; p.write_text(json.dumps(out,ensure_ascii=False,separators=(',',':'))+'\n')"
# RUN: not %python %harness/tools/check_sps_run_report.py --root %harness --expect-arm ConfigurationRejectedV1 --report %t.scrambled.json 2>&1 | %FileCheck %s --check-prefix=SCRAMBLED
# SCRAMBLED: report fields/order mismatch: ('reason', 'formatId', 'disposition')


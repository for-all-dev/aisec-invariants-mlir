{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sps.dev/harness/source-boundary/contracts.schema.json",
  "title": "Nonclaimable SPS harness contract-call authoring locators",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-id", "claim-boundary", "contracts"],
  "properties": {
    "format-id": {
      "const": "SPS-Harness-Authoring-Contracts-v1"
    },
    "claim-boundary": {
      "const": "NonClaimableAuthoringLocator"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "scalar-type": {
      "type": "string",
      "pattern": "^i[1-9][0-9]*$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "result"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scalar-type"
          }
        },
        "result": {
          "oneOf": [
            {"const": "void"},
            {"$ref": "#/$defs/scalar-type"}
          ]
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callee", "call-ordinal"],
      "properties": {
        "callee": {
          "$ref": "#/$defs/symbol"
        },
        "call-ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locator",
        "source-host",
        "destination-host",
        "signature",
        "memory-effects",
        "choice",
        "total",
        "deterministic",
        "representation",
        "limitations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "source-host": {
          "$ref": "#/$defs/id"
        },
        "destination-host": {
          "$ref": "#/$defs/id"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "memory-effects": {
          "const": []
        },
        "choice": {
          "const": "Unit"
        },
        "total": {
          "const": true
        },
        "deterministic": {
          "const": true
        },
        "representation": {
          "const": "SPS-ContractWire-v2"
        },
        "limitations": {
          "const": [
            "NoFunctionSemantics",
            "NotCanonicalContractTableV2"
          ]
        }
      }
    }
  }
}
